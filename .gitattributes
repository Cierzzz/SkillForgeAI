# Normalise line endings so the repo behaves the same on Windows, macOS and Linux.
* text=auto eol=lf

*.js  text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.toml text eol=lf

*.png binary
*.jpg binary
*.svg text eol=lf